<?xml version="1.0" encoding="utf-8"?>
<!--
  Rien ne quitte l'appareil : la conception (§2, §3) exclut toute
  synchronisation, et le journal des prises est une donnée de santé. On exclut
  donc l'intégralité des données de l'application, aussi bien de la sauvegarde
  dans le nuage que du transfert d'appareil à appareil (API 31+).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
